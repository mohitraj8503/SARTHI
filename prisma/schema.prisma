}

model EducationEntry {
  id             String             @id @default(cuid())
  applicationId  String
  institution    String
  degree         String
  fieldOfStudy   String?
  graduationYear Int?
  application    TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("education_entries")
}

model TeacherDocument {
  id            String             @id @default(cuid())
  applicationId String
  type          String
  fileUrl       String             @db.Text
  fileName      String?
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("teacher_documents")
}

model LiveSession {
  id                         String               @id @default(cuid())
  courseId                   String
  title                      String
  description                String?              @db.Text
  startTime                  DateTime
  endTime                    DateTime
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  actualEnd                  DateTime?
  actualStart                DateTime?
  attendanceCount            Int                  @default(0)
  meetingLink                String?              @unique
  meetingPlatform            String?
  recordingUrl               String?              @db.Text
  status                     String               @default("scheduled")
  teacherId                  String
  cancelReason               String?              @db.Text
  cancelledAt                DateTime?
  difficultyLevel            String?
  durationMinutes            Int?
  isRequired                 Boolean              @default(false)
  joinUrl                    String?
  learningObjectives         String?              @db.Text
  lessonId                   String?
  maxParticipants            Int?
  moduleId                   String?
  orderNumber                Int?
  privacy                    String               @default("enrolled")
  recordingEnabled           Boolean              @default(true)
  roomId                     String?              @unique
  shareRecordingWithStudents Boolean              @default(true)
  tags                       String?              @db.Text
  egressId                   String?
  googleDriveFileId          String?
  isRecording                Boolean              @default(false)
  recordingStartedAt         DateTime?
  course                     Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher                    Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  module                     Module?              @relation("ModuleLiveSessions", fields: [moduleId], references: [id], onDelete: SetNull)
  linkedLesson               Lesson?              @relation("LessonLiveSession")
  attendance                 SessionAttendance[]
  messages                   LiveSessionMessage[]
  recording                  Recording?
  chatMessages               ChatMessage[]

  @@index([courseId])
  @@index([teacherId])
  @@index([courseId, status])
  @@index([teacherId, startTime])
  @@index([status, startTime])
  @@index([moduleId])
  @@index([roomId])
  @@map("live_sessions")
}

model LiveSessionMessage {
  id         String      @id @default(cuid())
  sessionId  String
  senderId   String
  senderName String
  senderRole String      @default("student")
  content    String      @db.Text
  isDeleted  Boolean     @default(false)
  isEdited   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("live_session_messages")
}

model UnmatchedQuery {
  id        String   @id @default(cuid())
  phrase    String   @db.Text
  frequency Int      @default(1)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("unmatched_queries")
}

model MetricOverride {
  id        String   @id @default(cuid())
  phrase    String   @unique
  metricId  String
