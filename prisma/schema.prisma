generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
}

model User {
  id                         String                        @id @default(cuid())
  email                      String                        @unique
  username                   String?                       @unique
  enrollmentNumber           String?                       @unique
  name                       String?
  emailVerified              DateTime?
  password                   String?
  role                       String                        @default("STUDENT")
  bio                        String?                       @db.Text
  image                      String?                       @db.Text
  avatar_url                 String?                       @db.Text
  avatar_version             Int                           @default(0)
  signatureUrl               String?
  company                    String?
  headline                   String?
  location                   String?
  socialLinks                String?
  privacySettings            String?
  grade                      String?
  totalPoints                Int                           @default(0)
  lastActive                 DateTime                      @default(now())
  youtubeAccessToken         String?
  youtubeRefreshToken        String?
  youtubeTokenExpiry         String?
  authProvider               String?
  oauthId                    String?
  oauthImage                 String?
  accessToken                String?
  refreshToken               String?
  verificationToken          String?                       @unique
  verificationExpires        DateTime?
  failedLoginAttempts        Int                           @default(0)
  lastLogin                  DateTime?
  status                     String                        @default("ACTIVE")
  twoFactorEnabled           Boolean                       @default(false)
  onboarded                  Boolean                       @default(false)
  loginCount                 Int                           @default(0)
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  notificationSettings       String?
  phone                      String?
  college                    String?
  currentCourse              String?
  lastQualification          String?
  youtubeChannelId           String?
  youtubeChannelTitle        String?
  blogWriterApprovedAt       DateTime?
  passwordSetupExpires       DateTime?
  passwordSetupToken         String?                       @unique
  resetToken                 String?                       @unique
  resetTokenExpires          DateTime?
  referralCode               String?                       @unique
  referredById               String?
  hasInternshipBadge         Boolean                       @default(false)
  blogAccessStatus           String                        @default("none")
  blogStrikes                Int                           @default(0)
  blogTrustScore             Int                           @default(0)
  isBlogTrusted              Boolean                       @default(false)
  studentId                  String?                       @unique
  platformSegment            PlatformSegment               @default(PENDING)
  educationLevel             EducationLevel?
  onboardingStatus           String                        @default("NOT_STARTED")
  requiresPasswordChange     Boolean                       @default(false)
  tempPassword               String?                       @db.Text
  referredBy                 User?                         @relation("UserReferrals", fields: [referredById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals                  User[]                        @relation("UserReferrals")
  userStreak                 UserStreak?                   @relation("UserStreak")
  youtubeMappings            CourseYouTubeMapping[]
  paymentIntents             PaymentIntent[]
  profile                    Profile?
  marketingPartner           MarketingPartner?
  freelancer                 Freelancer?                   @relation("FreelancerProfile")
  clientProjects             Project[]                     @relation("ClientProjects")
  developerInterests         ProjectInterest[]             @relation("DeveloperInterests")
  streaks                    Streak[]
  xp                         XPTransaction[]
  accounts                   Account[]
  adminActions               AdminAuditLog[]               @relation("AdminActions")
  announcements              Announcement[]
  answers                    Answer[]
  assessmentSessions         AssessmentSession[]
  assignmentSubmissions      AssignmentSubmission[]        @relation("UserAssignmentSubmissions")
  attendance                 Attendance[]
  blogPosts                  BlogPost[]                    @relation("BlogAuthor")
  blogBookmarks              BlogBookmark[]                @relation("UserBlogBookmarks")
  certificates               Certificate[]
  certificationAttempts      CertificationAttempt[]
  certifications             Certification[]
  certificationRegistrations CertificationRegistration[]
  chatMessages               ChatMessage[]
  conversations              ConversationParticipant[]
  courseReviews              CourseReview[]
  courses                    Course[]
  enrollments                Enrollment[]
  feedbackSubmitted          Feedback[]
  focusSessions              FocusSession[]                @relation("UserFocusSessions")
  forumComments              ForumComment[]
  forumPosts                 ForumPost[]
  invoices                   Invoice[]
  issuedCertificates         IssuedCertificate[]
  kbArticles                 KBArticle[]                   @relation("KBAuthor")
  learningGoal               LearningGoal?                 @relation("UserLearningGoal")
  learningSessions           LearningSession[]             @relation("UserLearningSessions")
  receivedMessages           Message[]                     @relation("MessageReceiver")
  sentMessages               Message[]                     @relation("MessageSender")
  messageReactions           MessageReaction[]
  notes                      Note[]
  notifications              Notification[]
  pushSubscriptions          PushSubscription[]
  pendingPurchases           PendingPurchase[]
  progress                   Progress[]
  questions                  Question[]
  quizSubmissions            QuizSubmission[]
  securityEvents             SecurityEvent[]
  seminarRegistrations       SeminarRegistration[]
  seminarQuestions           SeminarQuestion[]
  seminarPollVotes           SeminarPollVote[]
  seminarRequests            SeminarRequest[]              @relation("TeacherSeminarRequests")
  seminars                   Seminar[]
  sessions                   Session[]
  skillGaps                  SkillGap[]                    @relation("UserSkillGaps")
  speaker                    Speaker?
  studentActivities          StudentActivity[]             @relation("StudentActivities")
  studentNotes               StudentNote[]                 @relation("UserNotes")
  gradedBy                   Submission[]                  @relation("GradedBy")
  submissions                Submission[]                  @relation("StudentSubmissions")
  subscription               Subscription?
  assignedTickets            SupportTicket[]               @relation("TicketAssignee")
  tickets                    SupportTicket[]
  teacher                    Teacher?
  threadMemberships          ThreadMember[]
  ticketMessages             TicketMessage[]
  transactions               Transaction[]
  achievements               UserAchievement[]
  userPresence               UserPresence?
  videoBookmarks             VideoBookmark[]               @relation("UserVideoBookmarks")
  videoProgress              VideoProgress[]
  videoReactions             VideoReaction[]               @relation("UserVideoReactions")
  videos                     Video[]
  weeklyReports              WeeklyReport[]                @relation("UserWeeklyReports")
  workshopRegistrations      WorkshopRegistration[]
  workshops                  Workshop[]                    @relation("InstructorWorkshops")
  userCertifications         UserCertification[]
  moduleProgress             CertificationModuleProgress[]
  blogWriterApplications     BlogWriterApplication[]
  reviewedApplications       BlogWriterApplication[]       @relation("AdminReviewer")
  olympiadBadges             OlympiadBadge[]               @relation("OlympiadBadgeUser")
  aiCurriculumProgress       AICurriculumProgress[]        @relation("AICurriculumProgressUser")
  csProgress                 CSProgress[]                  @relation("CSProgressUser")
  achievementCertificates    AchievementCertificate[]      @relation("AchievementCertificateUser")
  leaderboardPositions       LeaderboardPosition[]         @relation("LeaderboardPositionUser")
  schoolProfile              SchoolProfile?                @relation("SchoolProfileUser")
  seminarChatMessages        SeminarChatMessage[]
  liveAttendance             LiveAttendance[]
  liveParticipants           LiveParticipant[]
  inductionApplications      InductionApplication[]        @relation("UserInductionApplications")
  managedPrograms            InductionProgram[]            @relation("UserManagedPrograms")
  inductionMentor            InductionMentor?              @relation("UserInductionMentor")
  creatorSubmissions         CreatorInductionSubmission[]
  builderSubmissions         BuilderInductionSubmission[]
  certificationPayments      CertificationPayment[]
  teacherApplication         TeacherApplication?
  sentInboxMessages          InboxMessage[]                @relation("SentInboxMessages")
  receivedInboxMessages      InboxMessage[]                @relation("ReceivedInboxMessages")
  sessionAttendance          SessionAttendance[]
  calendarEvents             CalendarEvent[]
  calendarConnection         CalendarConnection?
  emailLogs                  EmailLog[]
  blogAccessRequests         BlogAccessRequest[]           @relation("UserBlogAccessRequests")
  wishlist                   Wishlist[]
  assignmentAttempts         AssignmentAttempt[]
  courseEvents               CourseEvent[]
  mfaConfig                  MfaConfig?
  squadsLed                  Squad[]                       @relation("SquadLeader")
