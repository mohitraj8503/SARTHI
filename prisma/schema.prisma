model JuniorProfile {
  id                String              @id @default(cuid())
  firstName         String
  ageRange          AgeRange
  talentCategories  String?             @db.Text
  parentEmail       String              @unique
  schoolId          String?
  parentConsent     Boolean             @default(false)
  consentVerifiedAt DateTime?
  consentMethod     ConsentMethod?
  submissionsCount  Int                 @default(0)
  featuredCount     Int                 @default(0)
  lastActiveAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  school            SchoolProfile?      @relation("SchoolJuniorProfiles", fields: [schoolId], references: [id])
  submissions       JuniorSubmission[]
  achievements      JuniorAchievement[]
  applications      Application[]

  @@index([parentEmail])
  @@index([schoolId])
