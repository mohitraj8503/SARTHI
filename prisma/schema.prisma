}

model CourseSubscription {
  id                     String                   @id @default(cuid())
  userId                 String
  courseId               String
  razorpaySubscriptionId String                   @unique
  razorpayPlanId         String
  status                 CourseSubscriptionStatus
  currentMonth           Int                      @default(0)
  totalMonths            Int
  amountPerMonth         Int // in paise
  startedAt              DateTime?
  nextChargeAt           DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                 Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments               SubscriptionPayment[]

  @@index([userId])
  @@index([courseId])
  @@map("course_subscriptions")
}

model SubscriptionPayment {
  id                     String             @id @default(cuid())
  subscriptionId         String
  razorpayPaymentId      String             @unique
  amount                 Int // in paise
  status                 String // 'CAPTURED' or 'FAILED'
  chargedAt              DateTime           @default(now())
  createdAt              DateTime           @default(now())

  subscription           CourseSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_payments")
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
}

model LiveClass {
  id                  String               @id @default(cuid())
  courseId            String
  teacherId           String
  title               String
  description         String?              @db.Text
  scheduledAt         DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  youtubeBroadcastId  String?
  youtubeStreamId     String?
  youtubeVideoId      String?
  status              LiveClassStatus      @default(SCHEDULED)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // LiveKit fields
  roomName            String?              @unique  // LiveKit room name (null = YouTube-only class)
  liveKitStatus       String?                       // "SCHEDULED" | "LIVE" | "ENDED" | "CANCELLED"
  liveKitStartedAt    DateTime?
  liveKitEndedAt      DateTime?
  isLocked            Boolean              @default(false) // true = token API blocks new student joins

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher             User                 @relation("TeacherLiveClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  attendances         LiveClassAttendance[]
  chatMessages        LiveClassChatMessage[]
  raisedHands         LiveClassRaisedHand[]
  recording           LiveClassRecording?

  @@index([status])
  @@index([courseId])
  @@index([teacherId])
  @@index([liveKitStatus])
  @@index([roomName])
  @@map("live_classes")
}

model LiveClassAttendance {
  id          String    @id @default(cuid())
  liveClassId String
  studentId   String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([liveClassId])
  @@index([studentId])
  @@map("live_class_attendances")
}

model LiveClassRecording {
  id              String    @id @default(cuid())
  liveClassId     String    @unique
  courseId        String
  youtubeVideoId  String?                    // kept for backward compat (YouTube recordings)
  durationSeconds Int?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // LiveKit / Egress fields
  egressId        String?   @unique           // LiveKit egress job ID
  recordingStatus String    @default("PROCESSING")  // PROCESSING | UPLOADING_TO_DRIVE | READY | FAILED
  tempS3Key       String?                    // temp object path in S3/R2 bucket
  driveFileId     String?                    // Google Drive file ID after upload
  driveViewUrl    String?   @db.Text          // shareable Drive preview link
  durationSec     Int?                        // computed from egressInfo duration
  fileSizeBytes   BigInt?                    // raw file size in bytes
  uploadedAt      DateTime?                  // when Drive upload completed
  failureReason   String?   @db.Text          // error message when recordingStatus = FAILED

  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([egressId])
  @@index([recordingStatus])
  @@map("live_class_recordings")
}

