  title          String
  description    String?                @db.Text
  category       String?
  duration       Int?
  mentorId       String?
  mentorMentorId String?
  level          String?
  seats          Int                    @default(0)
  thumbnail      String?
  curriculum     String?                @db.Text
  startDate      DateTime?
  endDate        DateTime?
  prerequisites  String?                @db.Text
  faq            String?                @db.Text
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  mentor         User?                  @relation("UserManagedPrograms", fields: [mentorId], references: [id])
  mentorMentor   InductionMentor?       @relation("MentorInductionPrograms", fields: [mentorMentorId], references: [id])
  applications   InductionApplication[]

  @@index([mentorId])
  @@index([mentorMentorId])
  @@index([category])
  @@index([level])
  @@index([isActive])
  @@map("induction_programs")
}

model InductionApplication {
  id                 String           @id @default(cuid())
  userId             String
  inductionProgramId String
  status             String           @default("PENDING")
  appliedAt          DateTime         @default(now())
  notes              String?          @db.Text
  user               User             @relation("UserInductionApplications", fields: [userId], references: [id])
  inductionProgram   InductionProgram @relation(fields: [inductionProgramId], references: [id])

  @@unique([userId, inductionProgramId])
  @@index([userId])
  @@index([inductionProgramId])
  @@index([status])
  @@index([appliedAt])
  @@map("induction_applications")
}

model CreatorInductionSubmission {
  id                  String   @id @default(cuid())
  userId              String
  fullName            String
  email               String
  domain              String
  videoUrl            String?
  videoTopic          String?
  inspiration         String?  @db.Text
  goal                String?  @db.Text
  toolsUsed           String?
  portfolioLinks      String?
  instagram           String?
  commitmentLevel     String?
  status              String   @default("PENDING")
  appliedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  description         String?  @db.Text
  badgeAwarded        Boolean  @default(false)
  performanceCategory String?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("creator_induction_submissions")
}

model BuilderInductionSubmission {
  id                  String   @id @default(cuid())
  userId              String
  fullName            String
  email               String
  domain              String
  projectTitle        String
  elevatorPitch       String   @db.Text
  problemStatement    String   @db.Text
  solutionOverview    String   @db.Text
  targetUsers         String   @db.Text
  techStack           String   @db.Text
  architectureSummary String   @db.Text
  keyFeatures         String   @db.Text
  githubRepo          String
  liveDemo            String?
  videoDemoUrl        String
  screenshot1         String?
  screenshot2         String?
  screenshot3         String?
  metrics             String?  @db.Text
  status              String   @default("PENDING")
  score               Int      @default(0)
  scoreProblemClarity Int      @default(0)
  scoreInnovation     Int      @default(0)
  scoreTechnicalDepth Int      @default(0)
  scoreExecution      Int      @default(0)
  scoreDemoClarity    Int      @default(0)
  scoreImpact         Int      @default(0)
  reviewerNotes       String?  @db.Text
  appliedAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  isIndustrySelected  Boolean  @default(false)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([score])
  @@map("builder_induction_submissions")
}

model InductionMentor {
  id                String             @id @default(cuid())
  userId            String             @unique
  bio               String?            @db.Text
  expertise         String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation("UserInductionMentor", fields: [userId], references: [id])
  inductionPrograms InductionProgram[] @relation("MentorInductionPrograms")

  @@index([userId])
  @@map("induction_mentors_archived_20260731")
}

model TeacherApplication {
  id                 String                   @id @default(cuid())
  userId             String?                  @unique
  email              String                   @unique
  fullName           String
  phone              String?
  status             TeacherApplicationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedBy         String?
  rejectionReason    String?
  availability       String?                  @db.Text
  bio                String?                  @db.Text
  expertise          String?                  @db.Text
  portfolioLinks     String?                  @db.Text
  preferredSubjects  String?                  @db.Text
  profilePhotoUrl    String?                  @db.Text
  teachingPhilosophy String?                  @db.Text
  yearsOfExperience  Int?
  updatedAt          DateTime                 @default(now()) @updatedAt
  city               String?
  country            String?
  currentStep        Int                      @default(1)
  demoVideoUrl       String?                  @db.Text
  headline           String?
  languages          String?                  @db.Text
  preferredLevel     String?
  pricing            String?                  @db.Text
  skills             String?                  @db.Text
  linkedinUrl        String?                  @db.Text
