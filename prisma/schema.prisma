model JuniorAchievement {
  id          String        @id @default(cuid())
  juniorId    String
  title       String
  description String?
  icon        String?
  unlockedAt  DateTime      @default(now())
  junior      JuniorProfile @relation(fields: [juniorId], references: [id])

  @@map("junior_achievements_archived_20260731")
}

model JuniorConsentToken {
