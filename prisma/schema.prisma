}

model JuniorSubmission {
  id              String           @id @default(cuid())
  juniorId        String
  title           String           @db.VarChar(100)
  description     String?          @db.Text
  category        TalentCategory
  mediaUrl        String
  mediaType       MediaType
  duration        Int?
  status          ModerationStatus @default(PENDING)
  moderatedBy     String?
  moderatedAt     DateTime?
  moderationNotes String?          @db.Text
  isPublic        Boolean          @default(false)
  parentApproved  Boolean          @default(false)
  featured        Boolean          @default(false)
  featuredAt      DateTime?
  views           Int              @default(0)
  likes           Int              @default(0)
  submittedAt     DateTime         @default(now())
  junior          JuniorProfile    @relation(fields: [juniorId], references: [id])

  @@index([juniorId])
  @@index([status])
  @@index([featured])
  @@map("junior_submissions")
}

model Opportunity {
  id             String          @id @default(cuid())
  title          String
  description    String          @db.Text
  type           OpportunityType
  provider       String
  eligibility    String          @db.Text
  applicationUrl String?
  deadline       DateTime?
  spotsAvailable Int?
  isPublic       Boolean         @default(true)
  featured       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  applications   Application[]

  @@index([type])
  @@index([featured])
  @@map("junior_opportunities")
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  juniorId      String
  status        ApplicationStatus @default(SUBMITTED)
  submittedAt   DateTime          @default(now())
  reviewedAt    DateTime?
  notes         String?           @db.Text
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id])
  junior        JuniorProfile     @relation(fields: [juniorId], references: [id])

  @@unique([opportunityId, juniorId])
