  @@unique([authProvider, oauthId])
  @@index([studentId])
  @@index([createdAt])
  @@index([lastActive])
  @@index([role])
  @@index([status])
  @@map("users")
}

model SystemCounter {
  id        String   @id
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("system_counters")
}

model Course {
  id                       String                @id @default(cuid())
  title                    String
  description              String?               @db.Text
  thumbnail                String?
  price                    Decimal               @db.Decimal(10, 2)
  pricing_type             String                @default("FREE")
  preview_media_id         String?
  category                 String?
  instructorId             String
  enrolledStudentsCount    Int                   @default(0)
  lastContentUpdate        DateTime?
  isPublished              Boolean               @default(false)
  isFeatured               Boolean               @default(false)
  duration                 Int?
  youtubePlaylistId        String?               @unique
  youtube_channel_handle   String?
  playlist_privacy         String                @default("private")
  publish_state            String                @default("draft")
  ordering_strategy        String                @default("by_lesson_position")
  last_sync_ts             DateTime?
  course_thumbnail_url     String?
  level                    String                @default("Beginner")
  syllabusUrl              String?
  introVideoUrl            String?
  startDate                DateTime?
  endDate                  DateTime?
  prerequisites            String?
  deviceLimit              Int?                  @default(3)
  teacherId                String?
  badge                    String?
  bundleIds                String?               @db.Text
  categoryId               String?
  homepageOrder            Int?
  isActive                 Boolean               @default(true)
  discountAmount           Float?
  discountPercent          Float?
  platformFee              Float?
  features                 String?               @db.Text
  iconUrl                  String?
  thumbnailUrl             String?
  metaDescription          String?
  metaTitle                String?
  originalPrice            Float?
  rating                   Float                 @default(0)
  ratingCount              Int                   @default(0)
  shortDescription         String?
  slug                     String?               @unique
  thumbnailColor           String?
  thumbnailIcon            String?
  youtubeBindingVerifiedAt DateTime?
  youtubeChannelId         String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @default(now()) @updatedAt
  effective_price_amount   Float?
  googleFolderId           String?
  status                   CourseStatus          @default(DRAFT)
  pricingType              PricingType           @default(ONE_TIME)
  subscriptionMonthlyAmount Int?
  subscriptionTotalMonths  Int?
  razorpayPlanId           String?
  courseSubscriptions      CourseSubscription[]
  moderatedAt              DateTime?
  moderatedBy              String?
  moderationNote           String?               @db.Text
  moderationStatus         String                @default("PENDING_REVIEW")
  chatMessages             ChatMessage[]
  youtubeMappings          CourseYouTubeMapping?
  paymentIntents           PaymentIntent[]
  announcements            Announcement[]
  certificates             Certificate[]
  courseReviews            CourseReview[]
  Category                 Category?             @relation(fields: [categoryId], references: [id])
  instructor               User                  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  teacher                  Teacher?              @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments              Enrollment[]
  forumPosts               ForumPost[]
  invoices                 Invoice[]
  learningSessions         LearningSession[]     @relation("CourseSessions")
  lessons                  Lesson[]
  notes                    Note[]
  pendingPurchases         PendingPurchase[]
  questions                Question[]
  quizzes                  Quiz[]
  skillGaps                SkillGap[]            @relation("CourseSkillGaps")
  studentNotes             StudentNote[]         @relation("CourseNotes")
  teacherEarnings          TeacherEarning[]
  transactions             Transaction[]
  videos                   Video[]
  seminars                 Seminar[]
  liveSessions             LiveSession[]
  courseVideos             CourseVideo[]
  modules                  Module[]
  templates                CourseTemplate[]
  collaborators            CourseCollaborator[]
  calendarEvents           CalendarEvent[]
  coupons                  Coupon[]
  wishlist                 Wishlist[]
  Assignment               Assignment[]
  events                   CourseEvent[]
  liveClasses                LiveClass[]
  liveClassRecordings        LiveClassRecording[]

  @@index([status])
  @@index([instructorId])
  @@index([category])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([categoryId])
  @@index([teacherId])
  @@map("courses")
}

model CourseYouTubeMapping {
  id               String   @id @default(cuid())
  courseId         String   @unique
  teacherId        String
  youtubeChannelId String
  playlistId       String
  lockToTeacher    Boolean  @default(true)
  lockToChannel    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher          User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([teacherId])
  @@map("course_youtube_mappings")
}

model YouTubeAuditLog {
  id         String   @id @default(cuid())
  teacherId  String
  action     String
  courseId   String?
  playlistId String?
  videoId    String?
  metadata   String?
  status     String
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@index([action])
  @@map("youtube_audit_logs")
}

model Lesson {
  id                     String                  @id @default(cuid())
  title                  String
  description            String?
  videoUrl               String?
  youtube_video_id       String?
  upload_status          String                  @default("QUEUED")
  position               Int                     @default(0)
  content                String?                 @db.Text
  contentType            String                  @default("video")
  duration               Int?
  courseId               String
  orderNumber            Int
  isPublished            Boolean                 @default(true)
  isFreePreview          Boolean                 @default(false)
  dueDate                DateTime?
  maxScore               Int?
  passingScore           Int?                    @default(60)
  timeLimit              Int?                    @default(30)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  originBroadcastId      String?
  originSeminarId        String?
  sourceType             String                  @default("UPLOAD")
  youtubePlaylistItemId  String?
  moduleId               String?
  completionCriteria     String?                 @db.Text
  isRequired             Boolean                 @default(true)
  liveSessionId          String?                 @unique
  egressId               String?
  googleDriveFileId      String?
  isRecording            Boolean                 @default(false)
  liveRoomName           String?                 @unique
  liveStatus             LiveStatus              @default(NOT_STARTED)
  recordingUrl           String?                 @db.Text
  scheduledAt            DateTime?
  type                   LessonType              @default(VIDEO)
  hasReminderBeenSent    Boolean                 @default(false)
  attendances            LiveAttendance[]
  scheduledNotifications ScheduledNotification[]
  liveSession            LiveSession?            @relation("LessonLiveSession", fields: [liveSessionId], references: [id], onDelete: SetNull)
  assignments            Assignment[]            @relation("LessonAssignments")
  course                 Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Note                   Note[]
  progress               Progress[]
  studentNotes           StudentNote[]           @relation("LessonNotes")
  submissions            Submission[]
  videoBookmarks         VideoBookmark[]         @relation("LessonBookmarks")
  videoReactions         VideoReaction[]         @relation("LessonReactions")
  versions               LessonVersion[]
  module                 Module?                 @relation(fields: [moduleId], references: [id])
  mediaAssets            MediaAsset[]
  questions              Question[]

  @@unique([courseId, orderNumber])
  @@index([courseId])
  @@index([liveSessionId])
  @@map("lessons")
}

model Enrollment {
  id                        String     @id @default(cuid())
  enrollmentNo              Int?       @unique
  enrollmentCode            String     @unique
  userId                    String
  courseId                  String
  status                    String     @default("active")
  enrolledBy                String     @default("self_purchase")
  enrolledByUserId          String?
  paymentId                 String?
  progressPercentage        Int        @default(0)
  lastAccessedAt            DateTime?
  completedAt               DateTime?
  expiryDate                DateTime?
  enrollmentNote            String?    @db.Text
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @default(now()) @updatedAt
  liveAttendanceRate        Float?
  liveSessionsAttended      Int        @default(0)
  liveSessionsRequired      Int        @default(0)
  moduleProgress            String?    @db.Text
  nextLessonId              String?
  nextLiveSessionId         String?
  isRestricted              Boolean    @default(false) @map("is_restricted")
  lastCompletedAssignmentId String?    @map("last_completed_assignment_id")
  pendingAssignments        Int        @default(0) @map("pending_assignment_count")
  squadId                   String?    @map("squad_id")
  course                    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes                     Note[]
  progress                  Progress[]
  squad                     Squad?     @relation(fields: [squadId], references: [id], onDelete: SetNull)
  referralCoupon            String?
  marketingCommission       MarketingCommission?

  @@unique([userId, courseId])
  @@index([createdAt])
  @@index([courseId])
  @@index([status])
  @@index([userId, courseId])
  @@index([userId])
  @@map("enrollments")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("wishlists")
}

model Progress {
  id           String     @id @default(cuid())
  userId       String
  enrollmentId String
  lessonId     String
  completed    Boolean    @default(false)
  completedAt  DateTime?
  watchedTime  Float      @default(0)
  lastPosition Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([userId])
  @@index([enrollmentId])
  @@index([updatedAt])
  @@index([lessonId])
  @@map("progress")
}

model Transaction {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  amount            Float
  currency          String   @default("INR")
  status            String
  razorpayPaymentId String?  @unique
  razorpayOrderId   String?  @unique
  invoiceNumber     String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
  @@index([courseId, status])
  @@index([invoiceNumber])
  @@map("transactions")
}

model Invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  userId        String
  courseId      String
  amount        Float
  currency      String   @default("INR")
  paymentStatus String   @default("unpaid")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([invoiceNumber])
  @@index([courseId])
  @@map("invoices")
}

model Quiz {
  id           String           @id @default(cuid())
  title        String
  timeLimit    Int              @default(30)
  passingScore Int              @default(60)
  courseId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  questions    QuizQuestion[]
  submissions  QuizSubmission[]
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  options       String
  correctAnswer Int
  points        Int    @default(10)
  orderNumber   Int
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizSubmission {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  score     Int
  maxScore  Int
  answer    String   @db.Text
  passed    Boolean
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@map("quiz_submissions")
}

model Achievement {
  id               String            @id @default(cuid())
  name             String
  description      String
  icon             String
  points           Int
  condition        String
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([achievementId])
  @@map("user_achievements")
}

/// MODEL ROLE: Core model for Studio, Course, and Custom Admin Issued Certificates.
/// DUAL SYNC POLICY: Kept in atomic sync with IssuedCertificate by status-service.ts and captureCertificateSnapshot.ts.
model Certificate {
  id                String   @id @default(cuid())
  certificateNumber String   @unique
  userId            String
  courseId          String?
  title             String?
  issuedAt          DateTime @default(now())
  certificateUrl    String?
  status            String   @default("VALID")
  metadata          String?  @db.Text
  certificateId     String?  @unique
  qrCode            String?
  tier              String   @default("free")
  verificationCount Int      @default(0)
  verificationToken String?  @unique
  certificateHash   String?
  enrollmentId      String?
  imageUrl          String?
  pdfUrl            String?
  htmlSnapshot      String?  @db.Text
  course            Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certificateId])
  @@index([verificationToken])
  @@index([courseId])
  // A course completion is a single credential.  Every issuance path must use
  // this key rather than treating a completion, payment activation, and manual
  // generation as separate certificates.
  @@unique([userId, courseId])
  @@map("certificates")
}

model Note {
  id           String      @id @default(cuid())
  userId       String
  courseId     String
  lessonId     String?
  content      String
  timestamp    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  enrollmentId String?
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])
  lesson       Lesson?     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@index([userId])
  @@map("notes")
}

model CertificateOTP {
  id            String    @id @default(cuid())
  phoneNumber   String
  certificateId String?
  code          String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@unique([phoneNumber, code])
  @@index([phoneNumber])
  @@index([certificateId])
  @@map("certificate_otps")
}

model BlogPost {
