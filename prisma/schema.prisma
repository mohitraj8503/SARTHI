  title           String
  slug            String         @unique
  content         String         @db.Text
  excerpt         String         @db.Text
  category        String
  authorId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  adminNote       String?        @db.Text
  featured        Boolean        @default(false)
  publishedAt     DateTime?
  readTime        Int            @default(5)
  status          String         @default("draft")
  submittedAt     DateTime?
  tags            String?        @db.Text
  thumbnail       String?        @db.Text
  views           Int            @default(0)
  likes           Int            @default(0)
  approvedAt      DateTime?
  metaDescription String?        @db.Text
  metaTitle       String?        @db.Text
  scheduledAt     DateTime?
  writtenAt       DateTime       @default(now())
  deletedAt       DateTime?
  seoTitle        String?        @db.Text
  focusKeyword    String?        @db.Text
  canonicalUrl    String?        @db.Text
  ogTitle         String?        @db.Text
  ogDescription   String?        @db.Text
  ogImage         String?        @db.Text
  robotsIndex     Boolean        @default(true)
  robotsFollow    Boolean        @default(true)
  coverAlt        String?        @db.Text
