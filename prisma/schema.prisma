  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([to])
  @@index([type])
  @@index([status])
  @@index([sentAt])
  @@map("email_logs")
}

model LiveAttendance {
  id       String    @id @default(cuid())
