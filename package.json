{
  "name": "sarthi",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "prebuild": "rimraf .next .next_stable tsconfig.tsbuildinfo",
    "build": "prisma generate && next build",
    "build:hostinger": "prisma generate && next build",
    "seed:projects": "npx tsx scripts/seed-all-projects.ts",
    "build:local": "prisma generate && cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" NEXT_CPU_COUNT=12 next build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" node server.js",
    "start:hostinger": "cross-env NODE_ENV=production NODE_OPTIONS='--max-old-space-size=2560' node server.js",
    "start:next": "cross-env NODE_OPTIONS='--max-old-space-size=8192' next start",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "precompute-metrics": "tsx scripts/precompute-metrics.ts"
  },
